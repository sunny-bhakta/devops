{
  "name": "devops-nodejs-app",
  "version": "1.0.0",
  "description": "Standalone Node.js app for CI/CD and AWS learning",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
